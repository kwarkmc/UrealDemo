  "developer_scripts": [
    {
      "path": "scripts/check-airframe-api.py",
      "sha256": "a83d399b0bf9c2b0940dfa5b1c4815c56fc1f87ee44c08f894fbf8fe15d6c80a",
      "description": "Live v1/v2 airframe contract check. Synthetic fixture is NOT C208B.\n\nRequires an initialized API/Unreal. Temporarily replaces the selector and one\ntest profile; finally restores their bytes and reloads the original paused model.\nFlight time/position are reset by profile reload, not restored to their prior values."
    },
    {
      "path": "scripts/check-automatic-api.py",
      "sha256": "28de60b67a1d2b427105ec773cb02285a52e3f2708448e3b12e70ece3724ec22",
      "description": "Live Unreal regression for automatic flight, actuators, gusts and profiles.\n\nRequires the nominal Thor profile, configured first runway, running API and engine.\nUses paused explicit steps; does not start/restart processes or retry writes.\nTemporarily changes aircraft/active.json and aircraft/runtime-check.json, preserving\ntheir bytes in finally. Restores the original profile, calm air, cleared failures,\npaused ground start, parking brake and 1x. Do not edit these files during the run.\nThis is a development check, not aircraft qualification."
    },
    {
      "path": "scripts/check-c208b-api.py",
      "sha256": "3a626b088e7f5f0032a7acfb0827bbc9d8eabac02ab7c67f629ca9f6f99d51d3",
      "description": "Live research-model check. Resets flight; restores selector bytes and wind in finally.\n\nNo UI automation. This checks software contracts, not real C208B performance."
    },
    {
      "path": "scripts/check-control-api.py",
      "sha256": "752a6d306e2aea7787c05b62e67cfbdfe9b2511de8231addc6d1b7868c08e11f",
      "description": "One integration check of the Python client, HTTP validation and running Unreal actor."
    },
    {
      "path": "scripts/check-engine-api.py",
      "sha256": "61e868c6924beaac23138a6fc1bcd3c70c4d0119ad3a5df50c16a99855cef90b",
      "description": "Check one real start/control/stop/restart cycle. API must be running, Unreal stopped."
    },
    {
      "path": "scripts/check-environment.ps1",
      "sha256": "e301776e7bc4b542d37a7f428352977f41f38276f1e1d44a8af4fc7533511a78"
    },
    {
      "path": "scripts/check-eoir-api.py",
      "sha256": "d494f7ac94529a3208f07d90f26eedd6d21c6c36f86a8f0bf8eba9c77071e864",
      "description": "Focused live EO/IR check; requires the running API, Unreal and Korea terrain.\n\nChanges paused aircraft pose and creates non-firing scene props. On success leaves\na paused CCD view tracking its tank; on failure removes its props, disables capture\nand restores a parked start. One explicit 0.5 s flight step checks live pointing;\nall captures are paused. Never starts/restarts processes.\nIR checks concern luminance display filters, not physical thermal measurements."
    },
    {
      "path": "scripts/check-flight-api.py",
      "sha256": "cb4ea9522aaff36a993f76ca076f40395e9c563862bbf4940c8d70af325db1e1",
      "description": "Check a running PIE FlightScene through the product HTTP API; resume afterward."
    },
    {
      "path": "scripts/check-gear-api.py",
      "sha256": "ca657e4968289e5a36e2731479b5464f7cc4b794a1d7dc59476ebb8c7a76062b",
      "description": "Focused live landing-gear check; requires the running API, Unreal and first runway.\n\nUses paused explicit steps, changes aircraft state, and finally restores calm air,\ncleared failures, gear down, parked ground start and 1x. Does not restart processes.\nOptional --impact adds a low-altitude gear-up body-impact fixture for development.\nNo measured landing-gear performance or qualification claim."
    },
